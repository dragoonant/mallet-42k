    "targets": [
      { "role": "unit", "owner": "friendly", "filter": { "keyword": "ADEPTUS ASTARTES" }, "state": "targetedByAttack", "count": 1 }
    ],
    "effect": { "modifyRoll": { "roll": "wound", "value": -1 } },
    "scope": { "who": "attacker" },
    "duration": "untilEndOfPhase",
    "limit": "oncePerPhase"
  }
