    {
      "id": "ade.sec.divine-judgement",
      "name": "Divine Judgement",
      "text": "At the start of battle round 1 your opponent picks one unit in their army that is neither a MONSTER nor a VEHICLE. At the end of the battle, score 10 victory points if that unit was destroyed by a melee attack from one of your ADEPTA SORORITAS models, or 6 if it was destroyed any other way. Score nothing if it survives.",
      "default": true,
      "scoring": [
        {
          "id": "divine-judgement-pick",
          "when": "round.start",
          "rounds": {
            "from": 1,
            "to": 1
          },
          "who": "both",
          "rule": "custom",
          "pointsPer": 0,
          "cap": 0,
          "code": "divineJudgementPick"
        },
        {
          "id": "divine-judgement",
          "when": "battle.end",
          "rounds": {
            "from": 1,
            "to": 5
          },
          "who": "both",
          "rule": "custom",
          "pointsPer": 6,
          "cap": 10,
          "code": "divineJudgementScore",
          "params": {
            "meleePoints": 10
          }
        }
      ]
    },
    {
      "id": "ade.sec.rites-of-reconsecration",
      "name": "Rites of Reconsecration",
      "text": "From battle round 2, at the end of each of your turns, score 3 victory points if at least one of your ADEPTA SORORITAS units that is not Battle-shocked has every model wholly within your opponent's deployment zone. The award is flat, once per turn.",
      "default": false,
      "scoring": [
        {
          "id": "rites-of-reconsecration",
          "when": "turn.end",
          "rounds": {
            "from": 2,
            "to": 5
          },
          "who": "active",
          "rule": "custom",
          "pointsPer": 3,
          "cap": 3,
          "code": "reclaimAndDominate",
          "params": {
            "keyword": "ADEPTA SORORITAS"
          }
        }
      ]
    }
  ],
