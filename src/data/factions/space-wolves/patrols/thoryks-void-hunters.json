          "when": "battle.end",
          "rounds": { "from": 5, "to": 5 },
          "rule": "custom",
          "pointsPer": 0,
          "cap": 12,
          "code": "bagTheBigUnScore",
          "params": { "unitPoints": 8, "beastbossPoints": 12, "bigScoreOn": "unit" }
        }
      ]
    },
    {
      "id": "sw.sec.reiving-conquerors",
      "name": "Reiving Conquerors",
      "text": "At the end of each of your opponent's turns, score 3 victory points if you control at least one No Man's Land objective marker and at least as many of them as your opponent.",
      "default": false,
      "scoring": [
        {
          "id": "reiving-conquerors",
          "when": "turn.end",
          "rounds": { "from": 1, "to": 5 },
          "who": "opponent",
          "rule": "custom",
          "pointsPer": 3,
          "cap": 3,
          "code": "reconnaissanceInForce",
          "params": { "tiePoints": 3 }
        }
      ]
    }
