[
  {
    "id": "ork.s.get-stuck-in",
    "faction": "ork",
    "name": "Get Stuck In",
    "text": "Use during the Fight phase, before you pick the next unit to fight. For the rest of the phase, one ORKS unit from your army that has not yet been selected to fight this phase treats its Pile-in and Consolidation moves as up to 6\" rather than 3\".",
    "cost": 1,
    "category": "battleTactic",
    "phases": ["fight"],
    "window": ["fight.start", "fight.attacksResolved"],
    "who": "either",
    "condition": { "phase": "fight" },
    "targets": [
      { "role": "unit", "owner": "friendly", "filter": { "keyword": "ORKS" }, "state": "notYetFought" }
    ],
    "code": "getStuckInDistance",
    "limit": "oncePerPhase"
  },
  {
    "id": "ork.s.brutal-but-kunnin",
    "faction": "ork",
    "name": "Brutal but Kunnin'",
    "text": "Use at the start of your Charge phase. For the rest of the phase, one ORKS INFANTRY unit from your army may declare a charge even though it Fell Back earlier this turn.",
    "cost": 1,
    "category": "strategicPloy",
    "phases": ["charge"],
    "window": "charge.start",
    "who": "active",
    "condition": { "phase": "charge" },
    "targets": [
      { "role": "unit", "owner": "friendly", "filter": { "keyword": "INFANTRY" } }
    ],
    "effect": { "chargeAfterFallBack": true },
    "scope": { "who": "self" },
    "duration": "untilEndOfPhase",
    "limit": "oncePerPhase"
  },
  {
    "id": "ork.s.krump-da-gitz",
    "faction": "ork",
    "name": "Krump da Gitz!",
    "text": "Use once an enemy unit finishes shooting during the opponent's Shooting phase, if it targeted one of your ORKS units. That unit immediately makes a Normal move of up to D6\", moving as near as it can to the enemy unit that shot at it.",
    "cost": 1,
    "category": "strategicPloy",
    "phases": ["shooting"],
    "window": "shooting.attacksResolved",
    "who": "reactive",
    "condition": { "phase": "shooting", "ownTurn": false },
    "targets": [
      { "role": "unit", "owner": "friendly", "filter": { "keyword": "ORKS" }, "state": "targetedByAttack" }
    ],
    "effect": { "move": { "distance": "D6", "kind": "surge" } },
    "params": { "asCloseAsPossibleTo": "target" },
    "scope": { "who": "self" },
    "duration": "instant",
    "limit": "oncePerPhase"
  },
  {
    "id": "ork.s.tough-as-squig-hide",
    "faction": "ork",
    "name": "Tough As Squig-hide",
    "text": "Use when one of your ORKS INFANTRY units is chosen as a target in the opponent's Shooting phase or either player's Fight phase. Until the phase ends, attacks against it whose Strength exceeds its Toughness suffer -1 to wound.",
    "cost": 1,
    "category": "battleTactic",
    "phases": [
      "shooting",
      "fight"
    ],
    "window": [
      "shooting.targetsDeclared",
      "fight.targetsDeclared"
    ],
    "who": "either",
    "condition": {
      "any": [
        {
          "phase": "shooting",
          "ownTurn": false
        },
        {
          "phase": "fight"
        }
      ]
    },
    "targets": [
      {
        "role": "unit",
        "owner": "friendly",
        "filter": {
          "keyword": "INFANTRY"
        },
        "state": "targetedByAttack",
        "count": 1
      }
    ],
    "when": {
      "strengthVsToughness": "gt"
    },
    "effect": {
      "modifyRoll": {
        "roll": "wound",
        "value": -1
      }
    },
    "scope": {
      "who": "attacker"
    },
    "duration": "untilEndOfPhase",
    "limit": "oncePerPhase"
  },
  {
    "id": "ork.s.bestial-bellow",
    "faction": "ork",
    "name": "Bestial Bellow",
    "text": "Use at the start of the Fight phase. Pick one of your BEASTBOSS or SQUIGHOG BOYZ models, then an enemy unit within 3\" of it. That unit takes a Battle-shock test with 1 subtracted from the roll.",
    "cost": 1,
    "category": "epicDeed",
    "phases": [
      "fight"
    ],
    "window": [
      "fight.start"
    ],
    "who": "either",
    "condition": {
      "phase": "fight"
    },
    "targets": [
      {
        "role": "model",
        "owner": "friendly",
        "filter": {
          "keyword": "BEAST SNAGGA"
        },
        "count": 1
      },
      {
        "role": "unit",
        "owner": "enemy",
        "filter": {
          "within": {
            "of": "previousTarget",
            "inches": 3
          }
        },
        "count": 1
      }
    ],
    "code": "bestialBellow",
    "limit": "oncePerPhase"
  },
  {
    "id": "ork.s.get-in-there",
    "faction": "ork",
    "name": "Get In There!",
    "text": "Use in the Fight phase after one of your ORKS units is picked to fight, before it Piles In. Until the phase ends, its Pile-in moves may be up to 6\" instead of 3\". Consolidation is unchanged.",
    "cost": 1,
    "category": "battleTactic",
    "phases": [
      "fight"
    ],
    "window": [
      "fight.unitSelected"
    ],
    "who": "either",
    "condition": {
      "phase": "fight"
    },
    "targets": [
      {
        "role": "unit",
        "owner": "friendly",
        "filter": {
          "keyword": "ORKS"
        },
        "state": "selectedToFight",
        "count": 1
      }
    ],
    "code": "getStuckInDistance",
    "params": {
      "pileIn": 6,
      "pileInOnly": true
    },
    "duration": "untilEndOfPhase",
    "limit": "oncePerPhase"
  }
]
