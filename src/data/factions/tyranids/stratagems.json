[
  {
    "id": "tyr.s.hyper-reactive",
    "faction": "tyranids",
    "name": "Hyper-Reactive",
    "text": "Use just after an enemy unit selects its targets, in the opponent's Shooting phase or in the Fight phase, when one of your TYRANIDS INFANTRY units is a target. Until the end of the phase, every attack that targets that unit takes -1 to its hit roll.",
    "cost": 1,
    "category": "battleTactic",
    "phases": ["shooting", "fight"],
    "window": ["shooting.targetsDeclared", "fight.targetsDeclared"],
    "who": "either",
    "condition": { "any": [ { "phase": "shooting", "ownTurn": false }, { "phase": "fight" } ] },
    "targets": [
      { "role": "unit", "owner": "friendly", "filter": { "keyword": "INFANTRY" }, "state": "targetedByAttack", "count": 1 }
    ],
    "effect": { "modifyRoll": { "roll": "hit", "value": -1 } },
    "scope": { "who": "attacker" },
    "duration": "untilEndOfPhase",
    "limit": "oncePerPhase"
  },
  {
    "id": "tyr.s.voracious-assault",
    "faction": "tyranids",
    "name": "Voracious Assault",
    "text": "Use in your Shooting phase, or in the Fight phase, for one of your TYRANIDS units that has not yet been selected to shoot (or to fight). Until the end of the phase, each attack a model in that unit makes against the closest eligible target may re-roll its hit roll.",
    "cost": 1,
    "category": "battleTactic",
    "phases": ["shooting", "fight"],
    "window": ["shooting.start", "shooting.attacksResolved", "fight.start", "fight.attacksResolved"],
    "who": "either",
    "condition": { "any": [ { "phase": "shooting", "ownTurn": true }, { "phase": "fight" } ] },
    "targets": [
      { "role": "unit", "owner": "friendly", "filter": { "keyword": "TYRANIDS" }, "state": "notYetShot", "count": 1 }
    ],
    "effect": { "when": { "targetIsClosestEligible": true }, "reroll": "all" },
    "scope": { "who": "self" },
    "duration": "untilEndOfPhase",
    "limit": "oncePerPhase",
    "code": "voraciousAssaultHit",
    "params": { "stateByPhase": { "shooting": "notYetShot", "fight": "notYetFought" } }
  },
  {
    "id": "tyr.s.teeming-broods",
    "faction": "tyranids",
    "name": "Teeming Broods",
    "text": "Use in your Movement phase, during the Reinforcements step, on one of your TERMAGANTS units, even one that has been destroyed. If it is on the battlefield, up to D6 of its destroyed models return to it. If it was destroyed, a new copy of the unit with 2D6 models is added to your army in Strategic Reserves.",
    "cost": 1,
    "category": "strategicPloy",
    "phases": ["movement"],
    "window": "movement.reinforcements",
    "who": "active",
    "condition": { "phase": "movement" },
    "targets": [
      { "role": "unit", "owner": "friendly", "filter": { "keyword": "TERMAGANTS" }, "includeDestroyed": true, "count": 1 }
    ],
    "limit": "oncePerPhase",
    "code": "teemingBroods",
    "params": { "reviveDice": "D6", "respawnDice": "2D6", "respawnCap": 20, "respawnTo": "strategicReserves" }
  },
  {
    "id": "tyr.s.swift-kills",
    "faction": "tyranids",
    "name": "Swift Kills",
    "text": "Use in the Fight phase, in either player's turn, on one of your TYRANIDS units that has not yet fought this phase. Until the end of the phase, its melee weapons improve their AP by 1 and gain Anti-Monster 4+ and Anti-Vehicle 4+.",
    "cost": 1,
    "category": "battleTactic",
    "phases": [
      "fight"
    ],
    "window": [
      "fight.start",
      "fight.attacksResolved"
    ],
    "who": "either",
    "condition": {
      "phase": "fight"
    },
    "targets": [
      {
        "role": "unit",
        "owner": "friendly",
        "filter": {
          "keyword": "TYRANIDS"
        },
        "state": "notYetFought",
        "count": 1
      }
    ],
    "effect": [
      {
        "when": {
          "weaponType": "melee"
        },
        "modifyStat": {
          "stat": "AP",
          "value": -1
        }
      },
      {
        "when": {
          "weaponType": "melee"
        },
        "grantWeaponAbility": {
          "ability": "ANTI",
          "keyword": "MONSTER",
          "value": 4
        }
      },
      {
        "when": {
          "weaponType": "melee"
        },
        "grantWeaponAbility": {
          "ability": "ANTI",
          "keyword": "VEHICLE",
          "value": 4
        }
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "untilEndOfPhase",
    "limit": "oncePerPhase"
  },
  {
    "id": "tyr.s.pheromonal-trace",
    "faction": "tyranids",
    "name": "Pheromonal Trace",
    "text": "Use at the end of your Command phase on one of your VON RYAN'S LEAPERS units within range of an objective marker you control. That marker becomes secured by you.",
    "cost": 1,
    "category": "strategicPloy",
    "phases": [
      "command"
    ],
    "window": "command.end",
    "who": "active",
    "condition": {
      "phase": "command"
    },
    "targets": [
      {
        "role": "unit",
        "owner": "friendly",
        "filter": {
          "keyword": "VON RYAN'S LEAPERS",
          "within": {
            "of": "controlledObjective",
            "inches": 3
          }
        },
        "count": 1
      }
    ],
    "code": "pheromonalTrace",
    "limit": "oncePerPhase"
  },
  {
    "id": "tyr.s.predators-not-prey",
    "faction": "tyranids",
    "name": "Predators, Not Prey",
    "text": "Use in your Movement phase or Charge phase on one of your TYRANIDS units that has not yet moved or declared a charge this phase. Until the end of the phase, its models pass Desperate Escape tests automatically, and may move through other models as if they were not there.",
    "cost": 1,
    "category": "strategicPloy",
    "phases": [
      "movement",
      "charge"
    ],
    "window": [
      "movement.start",
      "charge.start"
    ],
    "who": "active",
    "condition": {
      "ownTurn": true,
      "any": [
        {
          "phase": "movement"
        },
        {
          "phase": "charge"
        }
      ]
    },
    "targets": [
      {
        "role": "unit",
        "owner": "friendly",
        "filter": {
          "keyword": "TYRANIDS"
        },
        "state": "notYetActivated",
        "count": 1
      }
    ],
    "effect": [
      {
        "moveThroughModels": true
      },
      {
        "autoPassDesperateEscape": true
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "untilEndOfPhase",
    "limit": "oncePerPhase"
  }
]
