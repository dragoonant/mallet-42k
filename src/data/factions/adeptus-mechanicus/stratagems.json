  {
    "id": "adm.s.pcd-evaluation-of-mettle",
    "faction": "adeptus-mechanicus",
    "name": "An Evaluation of Mettle",
    "text": "Use just after an enemy unit has picked its targets, in the opponent's Shooting phase or in the Fight phase, when one of your ADEPTUS MECHANICUS units is a target. Until the end of the phase, models in that unit have Feel No Pain 5+.",
    "cost": 1,
    "category": "battleTactic",
    "phases": ["shooting", "fight"],
    "window": ["shooting.targetsDeclared", "fight.targetsDeclared"],
    "who": "either",
