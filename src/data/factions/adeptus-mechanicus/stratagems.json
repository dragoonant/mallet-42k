    "targets": [
      { "role": "unit", "owner": "friendly", "filter": { "keyword": "ADEPTUS MECHANICUS" }, "state": "targetedByAttack", "count": 1 }
    ],
    "effect": { "feelNoPain": 5 },
    "scope": { "who": "self" },
    "duration": "untilEndOfPhase",
    "limit": "oncePerPhase"
  },
  {
    "id": "adm.s.pcd-optimised-efficiency",
