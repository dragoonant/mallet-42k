    "targets": [
      { "role": "unit", "owner": "friendly", "filter": { "keyword": "ADEPTUS MECHANICUS" }, "count": 1 }
    ],
    "effect": [ { "shootAfterFallBack": true }, { "chargeAfterFallBack": true } ],
    "scope": { "who": "self" },
    "duration": "untilEndOfTurn",
    "limit": "oncePerPhase",
    "code": "justFellBack"
  },
  {
    "id": "adm.s.pcd-acceptable-risk-ratio",
    "faction": "adeptus-mechanicus",
    "name": "Acceptable Risk Ratio",
    "text": "Use in your Shooting phase before you pick the next unit to shoot. Pick one ADEPTUS MECHANICUS unit that has not yet shot. Until the end of the phase, its ranged weapons improve their Armour Penetration by 1 and gain [HAZARDOUS].",
